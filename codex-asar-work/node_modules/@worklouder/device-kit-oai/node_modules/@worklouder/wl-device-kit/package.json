{
  "name": "@worklouder/wl-device-kit",
  "version": "0.1.18",
  "description": "Worklouder device kit library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser_safe": {
      "require": "./dist/browser_safe.js",
      "import": "./dist/browser_safe.js",
      "types": "./dist/browser_safe.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm-node"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:js": "esbuild src/index.ts src/browser_safe.ts --bundle --platform=node --format=cjs --outdir=dist --external:node-hid --external:serialport --external:node-mac-permissions --sourcemap",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "yarn build:js && yarn build:types",
    "wasm-build": "cd rust_wasm && wasm-pack build --target nodejs --out-dir ../wasm-node",
    "build:all": "yarn wasm-build && yarn build",
    "test": "vitest run",
    "prepare": "yarn build",
    "clean": "rm -rf dist wasm-node"
  },
  "dependencies": {
    "esptool-js": "^0.6.0",
    "node-hid": "^3.0.0",
    "semver": "^7.8.1",
    "serialport": "^12.0.0"
  },
  "optionalDependencies": {
    "node-mac-permissions": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.0",
    "jimp": "^1.6.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
